{
  "name": "animeon-desktop",
  "version": "0.5.1",
  "description": "AnimeOn Desktop",
  "main": "dist/main/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "concurrently \"vite\" \"tsc -p tsconfig.main.json --watch\" \"wait-on dist/main/index.js && electron .\"",
    "dev:renderer": "vite",
    "dev:main": "tsc -p tsconfig.main.json --watch",
    "build": "node scripts/build-release.cjs",
    "build:public": "node scripts/build-release.cjs --public",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "preview": "vite preview",
    "lint": "eslint src/renderer scripts/*.cjs *.js *.cjs",
    "test": "node scripts/check-current.cjs",
    "test:electron": "node scripts/check-electron.cjs"
  },
  "build": {
    "appId": "com.kotecy.animeon-desktop",
    "productName": "AnimeOn Desktop",
    "files": [
      "dist/**/*",
      "build/icon.png",
      "package.json"
    ],
    "publish": {
      "provider": "github",
      "owner": "Kotecy",
      "repo": "Animeon-Desktop"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "AnimeOn Desktop.exe"
    },
    "portable": {
      "unpackDirName": true
    },
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "extraMetadata": {
      "main": "dist/main/index.js"
    }
  },
  "dependencies": {
    "electron-store": "12.0.0"
  },
  "devDependencies": {
    "@electron/asar": "4.3.1",
    "@eslint/js": "10.0.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "autoprefixer": "10.6.2",
    "concurrently": "10.0.6",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "playwright": "1.64.1",
    "postcss": "8.5.32",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vite": "8.3.6",
    "wait-on": "9.5.1"
  },
  "engines": {
    "node": ">=24.13.0"
  }
}
